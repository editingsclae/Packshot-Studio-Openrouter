# OPENROUTER_API_KEY: Required server-side key for OpenRouter image generation and prompt enhancement.
# Never expose this key to the browser (do not prefix with NEXT_PUBLIC_).
OPENROUTER_API_KEY="sk-or-v1-..."

# OPENROUTER_ENHANCER_MODEL: Optional OpenRouter chat model used when "Enhance with AI" is enabled.
# Defaults to openai/gpt-4o-mini if omitted.
OPENROUTER_ENHANCER_MODEL="openai/gpt-4o-mini"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# APP_PASSWORD: Shared access gate password (required when NODE_ENV=production).
APP_PASSWORD=""

# APP_SESSION_SECRET: Optional dedicated HMAC key for signing session cookies (falls back to APP_PASSWORD if unset).
APP_SESSION_SECRET=""

# ALLOWED_MODELS: Optional comma-separated list of allowed OpenRouter image model IDs.
# Defaults to recommended product models + free Recraft when unset.
ALLOWED_MODELS=""

# MAX_REQUEST_USD: Maximum estimated USD allowed per generation/enhance request (default: 0.50).
MAX_REQUEST_USD="0.50"

# MAX_DAILY_USD: Maximum cumulative UTC daily spend in USD before returning HTTP 402 (default: 5).
MAX_DAILY_USD="5"

# ALLOW_HIGH_QUALITY: Set to "true" to allow quality values above "medium" on usage-based models (default: false).
ALLOW_HIGH_QUALITY="false"

# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN: Upstash Redis backend for shared daily spend & observed cost tracking (required for paid models on Vercel).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# TRUSTED_PROXY: Set to "true" behind a trusted reverse proxy (auto-enabled on Vercel); reads the last X-Forwarded-For entry.
# Example nginx directive: proxy_set_header X-Forwarded-For $remote_addr;
TRUSTED_PROXY="false"
